# Copiar como .env y completar. Nunca versionar .env (ni este archivo con valores).

# --- Mercado Público ---
# Ticket de la API (Clave Única del propietario). Solo hace falta desde /p2-api.
MP_TICKET=

# --- Cifrado en reposo (Fernet) ---
# Clave para cifrar el ticket de Mercado Público y otros secretos guardados en la base.
# Generar una vez (no requiere librerías adicionales):
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Guardar en un lugar seguro: si se pierde, lo cifrado con ella deja de poder leerse.
APP_ENCRYPTION_KEY=

# --- Supabase: proyecto de desarrollo "sistema-propuestas-dev" (Sao Paulo) ---
# Usado por el backend para verificar el JWT (JWKS) y, cuando aplique, llamar a la Data API / Storage.
# Panel: Project Settings -> Data API -> "Project URL".
SUPABASE_URL=
# Panel: Project Settings -> API Keys -> "anon public" (o la "Publishable key", sb_publishable_...; cualquiera
# de las dos sirve aquí). Nunca usar la "service_role" ni la "secret key" (sb_secret_...): esas tienen acceso
# completo y nunca deben llegar al frontend ni a este archivo.
SUPABASE_ANON_KEY=

# --- Conexion a la base: una sola cadena para la app, Alembic y el worker (ADR-0012) ---
# Session Pooler de Supabase (puerto 5432): soporta LISTEN/NOTIFY (lo necesita Procrastinate) y funciona por IPv4,
# sin depender de que esta red tenga IPv6 (la conexion directa de Supabase es IPv6 por defecto).
# Panel: Project Settings -> Database -> Connect -> pestana "Session pooler". Copiar esa cadena y reemplazar
# [YOUR-PASSWORD] por la contrasena de la base (mismo panel, "Database password"; se puede restablecer ahi).
# Formato esperado (SQLAlchemy + psycopg 3):
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Base de pruebas de integracion local (ADR-0012, docs/07 S0) ---
# Mismo proyecto Supabase de desarrollo, pero con el rol restringido "test_runner" (creado una sola vez a mano,
# instrucciones en /p3-fundaciones) y el esquema "test" fijado por search_path. Nunca toca el esquema "app".
# postgresql+psycopg://test_runner.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?options=-csearch_path%3Dtest
TEST_DATABASE_URL=

# --- Frontend (React + Vite, ADR-0013) ---
# Estas tres variables NO van en este .env de la raíz: van en frontend/.env.local (Vite, a diferencia de Next.js,
# tampoco lee el .env de la raíz del repo). Se listan aquí solo como referencia de qué debe existir y de dónde sale
# cada valor; cópialas a frontend/.env.local con estos mismos nombres.
# Vite solo expone al navegador las variables con prefijo VITE_: por eso nunca debe ir aquí una clave secreta
# (service_role, secret key, APP_ENCRYPTION_KEY, MP_TICKET, etc.) — cualquier cosa con este prefijo queda visible
# en el código que corre en el navegador de quien use la app.
# Mismos valores que SUPABASE_URL / SUPABASE_ANON_KEY de arriba (anon/publishable, nunca service_role/secret):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL del backend FastAPI. En local: http://localhost:8000
VITE_API_BASE_URL=
